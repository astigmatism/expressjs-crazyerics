extends layout

block content
    div#toolbar
        div(class="systemfilter")
            select(title="Filter your search to a specific system")
                option(value='all') All Consoles
        div(class="search")
            input(class="tooltip" title="Begin typing a name to see a list of results. Select a system for foreign or unofficial titles." type='text', name='search', data-hotkey='q', placeholder='Search')
        div(class="gamepads")
            ul
                li#gameid0
                li#gameid1
    div#content
        
        div#dialogs(class="darkgrad")
            div#dialogloadingbackground
            div(class="dialogwrapper")
                div(class="Welcome")
                    h2 Welcome!
                    p Get started by searching for a game or selecting a suggestion below
            div(class="dialogwrapper")
                div(class="WelcomeBack")
                    h2 Welcome Back
                    p Continue a game from your collection, search by title above, or browse suggestions below.
            div(class="dialogwrapper")
                div(class="PlayAgain")
                    h2 Play Again
                    p Continue a game from your collection, search by title above, or browse suggestions below.
            div(class="dialogwrapper")
                div(class="ConfigureGamepad")
                    h2 Configure Gamepad For #[span(class="gamepadsystem")]
                    p(class="gamepadconfigsubtitle") Configure this gamepad before continuing.
                    div#gamepadwrapper
                        div#gamepadassignmentvisual(class="gamepad-assignment-visual")
                        ul#gamepadinputs(class="gamepad-input-list")
                    div#gamepadconfigactions(class="gamepadconfigactions")
                        button#startgamepadover(type="button", class="button first zoom noselect") Start Assignment Over
                        button#skipgamepadconfig(type="button", class="button zoom noselect") Use Keyboard for Input Instead
                        button#cancelgamepadconfig(type="button", class="button remove zoom noselect", style="display:none") Cancel Any Changes
            div(class="dialogwrapper")
                div(class="ShaderSelection")
                    h2 Which display style would you like to play with?
                    ul#shaderselectlist
                    input#shaderselectcheckbox(type="checkbox") 
                    label Save this choice for all future #[span] games. You can reset this later.
            div(class="dialogwrapper")
                div(class="SaveSelection")
                    h2 Load a recent save state?
                    p Save states are emulator snapshots from Crazyerics. In-game saves from the game itself load automatically when the game boots.
                    ul#savesselectlist
                    button#loadnosaves(type="button", class="button zoom noselect") No, start new game
                    p(class="hide max") * You have reached the maximum number of saves allowed for this game. New saves will now replace the oldest saves.
                    p(class="hide near") * You are nearing the maximum number of saves allowed for this game. Delete some later to avoid new saves replacing the oldest saves. Unless that doesn't bother you.
            div(class="dialogwrapper")
                div(class="GameLoading")
                    h2 Now Loading
                    div#gameloadingwrapper(class="centered")
                    p#gameloadingname
                    div#loadingprogressbar
                    p#loadingstatus
            div(class="dialogwrapper")
                div(class="Exception")
                    h2 Game Error
                    p We can't realisticly expect every game to always work. Perhaps you can try again or refresh this page.
                    p#emulatorexceptiondetails
            div(class="dialogwrapper")
                div(class="SaveLoading")
                    h2 Loading Save State
                    div#saveloadingwrapper(class="centered")
            div(class="dialogwrapper")
                div(class="EmulatorCleanup")
                    h2 Cleaning Up
                    p Please wait while we cleanup this game and prepare for the next
                        

            div(class="dialogwrapper")
                div(class="FeaturedCollectionsAdmin dialog dialog-animation hide close")
                    h2 Manage Featured Collections
                    div(class="featured-admin-scroll")
                        p(class="featured-admin-intro") Rename, hide, sort, delete, or create featured collections. CSV imports are resolved against canonical Crazyerics game records before publishing. Download the master inventory TSV for exact system, title, and ROM values.
                        div#featuredcollectionsadminstatus(class="featured-admin-status", aria-live="polite")
                        div(class="featured-admin-body")
                            section(class="featured-admin-section featured-admin-list-section")
                                h3 Existing featured collections
                                div#featuredcollectionsadminlist(class="featured-admin-list")
                            section(class="featured-admin-section featured-admin-create-section")
                                h3 Create from CSV
                                div(class="featured-admin-create-layout")
                                    div(class="featured-admin-inventory-tools")
                                        h4 Master inventory
                                        p Use #[code master-inventory.tsv] with an AI model or spreadsheet editor to build featured collection CSV imports from exact inventory rows.
                                        a#featuredcollectionsadmininventorydownload(href="/admin/featured-collections/master-inventory.tsv", class="button zoom noselect featured-admin-inventory-download", download="master-inventory.tsv", target="featuredcollectionsadmininventoryframe") Download master-inventory.tsv
                                        span#featuredcollectionsadmininventorynote(class="featured-admin-inventory-note")
                                        iframe#featuredcollectionsadmininventoryframe(name="featuredcollectionsadmininventoryframe", class="featured-admin-download-frame", title="Master inventory download")
                                    div(class="featured-admin-create-main")
                                        div(class="featured-admin-create-grid")
                                            div(class="featured-admin-create-field featured-admin-create-field-title")
                                                label(for="featuredcollectionsadmintitle") Title
                                                input#featuredcollectionsadmintitle(type="text", maxlength="120")
                                            div(class="featured-admin-create-field")
                                                label(for="featuredcollectionsadminsort") Sort field
                                                select#featuredcollectionsadminsort
                                            div(class="featured-admin-create-field")
                                                label(for="featuredcollectionsadmindirection") Sort direction
                                                select#featuredcollectionsadmindirection
                                            div(class="featured-admin-create-field featured-admin-create-field-tags")
                                                label(for="featuredcollectionsadmintagsinput") Tags
                                                div#featuredcollectionsadmintags(class="featured-admin-tags-control")
                                            div(class="featured-admin-create-field featured-admin-create-field-priority")
                                                label(for="featuredcollectionsadminpriority") Priority
                                                select#featuredcollectionsadminpriority
                                            label(class="featured-admin-checkbox featured-admin-create-published", for="featuredcollectionsadminpublished")
                                                input#featuredcollectionsadminpublished(type="checkbox", checked)
                                                span Publish immediately
                                        div(class="featured-admin-import-grid")
                                            div(class="featured-admin-import-field")
                                                label(class="featured-admin-textarea-label", for="featuredcollectionsadminimport") Game CSV
                                                textarea#featuredcollectionsadminimport(rows="8", spellcheck="false")
                                            div(class="featured-admin-reference-field")
                                                span(class="featured-admin-textarea-label") Import reference
                                                pre#featuredcollectionsadminexample(class="featured-admin-example")
                                        div(class="featured-admin-create-actions")
                                            button#featuredcollectionsadminpreview(type="button", class="button zoom noselect") Preview import
                                            button#featuredcollectionsadmincreate(type="button", class="button play zoom noselect") Create featured collection
                                        div#featuredcollectionsadminpreviewresult(class="featured-admin-preview-result")
                        div(class="featured-admin-footer")
                            button#featuredcollectionsadminrefresh(type="button", class="button zoom noselect") Refresh
                            button#featuredcollectionsadminclose(type="button", class="button remove zoom noselect") Close


        div#emulatorwrapper
            div#emulatorfullscreencontrols(class="emulator-fullscreen-controls", aria-label="Emulator fullscreen controls")
                button#emulatorfullscreenoverlaybutton(type="button", class="controls-runtime-gamepad-configure-button button play zoom noselect", title="Exit browser fullscreen", aria-label="Exit browser fullscreen") Exit Full Screen
            div#emulatorcanvas
                div#emulatorpositionhelper
            
            textarea#output(rows="8")

            div#notificationwrapper(class="closed")
                div.spinner
                p The quick brown fox jumped over the lazy dog
        
            div#emulatorwrapperoverlay
                div
                    h2 Game Paused
                    p Click here to continue


        div#gamedetailsbackground
            div#gamedetailswrapper(class="darkgrad")
                div#gamedetailstable
                    div#gamedetailscontent
                        div#sliderwrapper
                            ul#slidericons
                                li(class="controls", data-slider="Controls", title="Controls") Controls
                                li(class="appearance", data-slider="Appearance", title="Display Style") Display Style
                                li(class="screenshots", data-slider="Screenshots", title="Screenshots") Screenshots
                                li(class="saves", title="Save States") Save States
                                li(class="info", data-slider="Info", title="Info") Info
                                li(class="versions", data-slider="Roms", title="Alternate Versions") Versions
                            //- sliding panels
                            div#sliderpanels
                                div#Controls-slider(class="slidingpanel closed")
                                    div(class="controls-slider-content")
                                        div(class="controls-slider-empty") Controls will appear when the game starts.
                                div#Appearance-slider(class="slidingpanel closed")
                                    div(class="slider-panel-card appearance-slider-card")
                                        div(class="appearance-slider-root")
                                div#Info-slider(class="slidingpanel closed")
                                    div(class="slider-panel-card info-slider-card")
                                        div(class="info-slider-body")
                                            div(class="info-slider-media")
                                                div#infosilderTitleScreen
                                            div(class="info-slider-copy")
                                                p(class="overview")
                                                div(class="info-slider-meta")
                                                    p(class="genre info-meta-row")
                                                    p(class="release info-meta-row")
                                                    p(class="publisher info-meta-row")
                                                    p(class="developer info-meta-row")
                                                    p(class="players info-meta-row")
                                div#Screenshots-slider(class="slidingpanel closed")
                                    div(class="slider-panel-card screenshots-slider-card")
                                        div(class="slider-panel-header")
                                            div(class="slider-panel-titlegroup")
                                                h3 Captured Screenshots
                                                p Press #[span(class="screenshot-key") T] while playing to capture a screenshot.
                                            div(class="screenshots-look-toggle-wrap")
                                                label(class="screenshots-look-toggle", for="screenshotsApplyLookToggle")
                                                    input#screenshotsApplyLookToggle(type="checkbox")
                                                    span(class="screenshots-look-toggle-text") Apply current look to screenshots
                                                div(class="screenshots-look-toggle-status", aria-live="polite") Screenshots are shown as captured.
                                        div(class="havescreens")
                                            p(class="screenshots-panel-note") Click an image or use Download to save it. Contribution buttons let you use a capture as the game screenshot or title screen.
                                            div#screenshotsGrid(class="grid screenshots-grid")
                                            p(class="screenshots-footnote") Screenshots shown here are temporary and will be lost when you leave or play another game.
                                        div(class="noscreens")
                                            div(class="slider-panel-empty")
                                                div(class="slider-panel-empty-title") No screenshots yet
                                                p Press #[span(class="screenshot-key") T] while playing to capture a screenshot.
                                div#Roms-slider(class="slidingpanel closed")
                                    div(class="slider-panel-card versions-slider-card")
                                        div(class="slider-panel-header")
                                            div(class="slider-panel-titlegroup")
                                                h3 Versions
                                                p Versions are alternate dumps, revisions, translations, or modified releases of this game. Choose one if you want to play a specific variant.
                                        div(class="versions-slider-body")
                                            div(class="versions-current-card")
                                                div(class="versions-current-label") Current version
                                                div#romsSliderCurrent(class="versions-current-title")
                                                div(class="versions-slider-count")
                                            div(class="versions-select-card")
                                                label(for="romsSliderSelect") Choose a version
                                                select#romsSliderSelect
                                                ul(class="versions-slider-notes")
                                                    li Your game collection will be updated to use the version of the game you select.
                                                    li Save states and in-game saves are specific to the game version you select.
                    div#gamedetailsboxfront
                        div(class="emulator-presentation-buttons")
                            button#emulatorfullscreenbutton(type="button", class="controls-runtime-gamepad-configure-button button play zoom noselect", title="Enter browser fullscreen", aria-label="Enter browser fullscreen") Enter Full Screen
                            button#emulatorwindowfillbutton(type="button", class="controls-runtime-gamepad-configure-button button play zoom noselect", title="Fill the browser window without using browser fullscreen", aria-label="Fill the browser window without using browser fullscreen") Fill Window
                        div#gamedetailsboxfrontimage
                        div#gamedetailsboxfrontmetadata
                            div#gamedetailsboxfronttitle
                            dl#gamedetailsboxfrontfacts

    - var shouldRenderCollectionTabs = typeof renderCollectionTabs !== 'undefined' && renderCollectionTabs === true
    div#collectionsWrapper(class=shouldRenderCollectionTabs ? null : 'collection-tabs-disabled')
        //- div#collectionTitle(class="collection-library-header", aria-live="polite")
        div#openCollectionGrid(class="grid collection-library-grid", aria-label="Games in the selected collection")
        if shouldRenderCollectionTabs
            div#collectionsRail(class="collection-rail-shell")
                div#collectionsGrid(class="grid collection-tab-rail", role="tablist", aria-label="Game collections") 
        else
            //- Collection tab controls are intentionally omitted from rendered HTML.

    div#suggestionswrapper
        div#suggestionsfilters
            div(class="suggestionsbar") Browse by name: 
                a A
                a B
                a C
                a D
                a E
                a F
                a G
                a H
                a I
                a J
                a K
                a L
                a M
                a N
                a O
                a P
                a Q
                a R
                a S
                a T
                a U
                a V
                a W
                a X
                a Y
                a Z
                a #
                input#browse-show-obscure(type="checkbox")
                div(class="tooltip" title="When browsing by letter, enable this to see all available games.") Reveal Obscure Titles
            //- div(class="suggestionsbar") Browse by year: (TODO: make cache for various sorted results)

        div#suggestionsgrid(class="grid")
        div#suggestionsloading(class="transparent")