shader1 = ../stock.glsl
filter_linear1 = false
wrap_mode1 = clamp_to_edge
mipmap_input1 = false
alias1 = ""
float_framebuffer1 = false
srgb_framebuffer1 = false
scale_type_x1 = viewport
